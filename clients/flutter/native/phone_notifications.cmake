# The locked Windows notification plugin omits unpackaged history removal.
# Narad's installer is unpackaged. Generate a build-local patch; never edit Pub cache.
get_target_property(narad_toast_sources flutter_local_notifications_windows SOURCES)
get_target_property(narad_toast_dir flutter_local_notifications_windows SOURCE_DIR)
set(narad_toast_found FALSE)
foreach(source IN LISTS narad_toast_sources)
  if(source MATCHES "ffi_api\\.cpp$")
    get_filename_component(input "${source}" ABSOLUTE BASE_DIR "${narad_toast_dir}")
    file(READ "${input}" text)
    set(anchor "if (plugin->hasIdentity) plugin->history.value().Remove(tag);")
    string(FIND "${text}" "${anchor}" position)
    if(position EQUAL -1)
      message(FATAL_ERROR "Windows notification plugin changed; review unpackaged cancellation")
    endif()
    string(REPLACE "${anchor}" "${anchor}\n  else plugin->history.value().Remove(tag, L\"\", plugin->aumid);" text "${text}")
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/narad_toast_api.cpp" "${text}")
    list(REMOVE_ITEM narad_toast_sources "${source}")
    set(narad_toast_found TRUE)
  endif()
endforeach()
if(NOT narad_toast_found)
  message(FATAL_ERROR "Windows notification source missing")
endif()
set_property(TARGET flutter_local_notifications_windows PROPERTY SOURCES ${narad_toast_sources})
target_include_directories(flutter_local_notifications_windows PRIVATE "${narad_toast_dir}")
target_sources(flutter_local_notifications_windows PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/narad_toast_api.cpp")
