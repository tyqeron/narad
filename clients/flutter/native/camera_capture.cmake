# Use a repository-owned replacement without modifying the global Pub cache.
# Reassess the ABI when upgrading flutter_webrtc beyond the locked 1.6.2 version.
get_target_property(narad_webrtc_sources flutter_webrtc_plugin SOURCES)
set(narad_capture_source_found FALSE)
foreach(narad_source IN LISTS narad_webrtc_sources)
  if(narad_source MATCHES "flutter_frame_capturer\\.cc$")
    list(REMOVE_ITEM narad_webrtc_sources "${narad_source}")
    set(narad_capture_source_found TRUE)
  endif()
endforeach()
if(NOT narad_capture_source_found)
  message(FATAL_ERROR "WebRTC capture ABI changed; review Narad camera replacement")
endif()

# Add per-track PCM recording through the locked plugin's method dispatcher.
# Generate a build-local copy so global Pub cache files remain untouched.
set(narad_dispatch_found FALSE)
foreach(narad_source IN LISTS narad_webrtc_sources)
  if(narad_source MATCHES "[/\\\\]flutter_webrtc\\.cc$")
    set(narad_dispatch "${narad_source}")
    # Plugin sources are normally absolute; resolve relative sources from its SOURCE_DIR.
    if(NOT IS_ABSOLUTE "${narad_source}")
      get_target_property(narad_plugin_dir flutter_webrtc_plugin SOURCE_DIR)
      get_filename_component(narad_dispatch "${narad_source}" ABSOLUTE BASE_DIR "${narad_plugin_dir}")
    endif()
    file(READ "${narad_dispatch}" narad_dispatch_text)
    string(FIND "${narad_dispatch_text}" "FlutterWebRTC::~FlutterWebRTC() {}" narad_destructor_index)
    if(narad_destructor_index EQUAL -1)
      message(FATAL_ERROR "WebRTC destructor ABI changed; review Narad audio capture cleanup")
    endif()
    string(REPLACE "#include \"flutter_webrtc.h\"" "#include \"flutter_webrtc.h\"\n#include \"audio_capture.h\"" narad_dispatch_text "${narad_dispatch_text}")
    string(REPLACE "FlutterWebRTC::~FlutterWebRTC() {}" "FlutterWebRTC::~FlutterWebRTC() { NaradAudioCaptureDispose(this); }" narad_dispatch_text "${narad_dispatch_text}")
    set(narad_dispatch_anchor "std::unique_ptr<MethodResultProxy> result) {")
    string(FIND "${narad_dispatch_text}" "${narad_dispatch_anchor}" narad_dispatch_index)
    if(narad_dispatch_index EQUAL -1)
      message(FATAL_ERROR "WebRTC dispatcher ABI changed; review Narad audio capture")
    endif()
    string(REPLACE "${narad_dispatch_anchor}" "${narad_dispatch_anchor}\n  if (NaradAudioCapture(this, method_call, result)) return;" narad_dispatch_text "${narad_dispatch_text}")
    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/narad_webrtc_dispatch.cc" "${narad_dispatch_text}")
    list(REMOVE_ITEM narad_webrtc_sources "${narad_source}")
    set(narad_dispatch_found TRUE)
  endif()
endforeach()
if(NOT narad_dispatch_found)
  message(FATAL_ERROR "WebRTC dispatcher missing; review Narad audio capture")
endif()
set_property(TARGET flutter_webrtc_plugin PROPERTY SOURCES ${narad_webrtc_sources})
target_include_directories(flutter_webrtc_plugin PRIVATE "${CMAKE_CURRENT_LIST_DIR}")
target_sources(flutter_webrtc_plugin PRIVATE
  "${CMAKE_CURRENT_LIST_DIR}/camera_frame_capturer.cc"
  "${CMAKE_CURRENT_LIST_DIR}/audio_capture.cc"
  "${CMAKE_CURRENT_BINARY_DIR}/narad_webrtc_dispatch.cc")
